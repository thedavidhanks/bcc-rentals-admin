# =============================================================================
# BCC Rentals Admin — environment variables (spec §11)
# Copy to .env.local and fill in. Never commit .env.local (it holds live secrets).
#
# The admin app does NOT use PayPal, Resend, or Upstash — it takes no payments,
# sends no customer email, and keeps no ephemeral order state.
# =============================================================================

# --- App ---------------------------------------------------------------------
# The admin app's own public URL. NEXT_PUBLIC_* values are inlined at BUILD TIME
# and also read at runtime — pass them as build env vars and runtime config.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# production on Cloud Run; development locally.
NODE_ENV="development"

# --- Neon (PostgreSQL) -------------------------------------------------------
# To modify prod use the command `DATABASE_URL_DEV= APPLY_TO_PROD=1 npm run db:apply`
# This modifies the environment variable DATABASE_URL in the production environment, which is used by the app to connect to the production database.
# Runtime queries use the Neon POOLED endpoint on the main (prod) branch — the
# SAME database as the storefront.
DATABASE_URL="postgresql://user:password@ep-rough-shadow-at0azjvb-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Neon DEV-branch direct endpoint, for one-off DDL/tooling only (apply-schema.mjs
# prefers this). Never point tooling at prod first.
DATABASE_URL_DEV="postgresql://user:password@ep-cool-field-at8or3b4.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# --- Firebase Web SDK (client) ------------------------------------------------
# These are NOT secrets (they ship to the browser) but are inlined at BUILD TIME
# and also needed at runtime — provide them for both build and runtime.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="bcc-rentals.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="bcc-rentals"
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Optional — only set if you use Firebase Cloud Messaging.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""

# --- Firebase Admin SDK (server) ---------------------------------------------
# Server-side token/cookie verification project id (same GCP project as the Web SDK).
FIREBASE_PROJECT_ID="bcc-rentals"
# LOCAL DEV ONLY: path to a service-account JSON key for the Admin SDK. On Cloud
# Run, leave this UNSET and rely on the runtime service account's Application
# Default Credentials (no key file).
GOOGLE_APPLICATION_CREDENTIALS="./secrets/firebase-admin-sa.json"

# --- Access control ----------------------------------------------------------
# Optional extra guard layered on top of the app_users lookup (e.g. bachmancc.org).
ALLOWED_EMAIL_DOMAIN=""

# --- Dev auth bypass ---------------------------------------------------------
# While NODE_ENV != production, a dev-only auth bypass is ON by default: the login
# page shows a role picker (Scheduler/Admin) instead of real Firebase sign-in, so
# the app is usable before the Firebase project (Q2) exists. Set to "off" to force
# the real Firebase path locally. IGNORED in production (always real Firebase).
AUTH_DEV_BYPASS="on"
